<Window x:Class="FisheyeFlattener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FisheyeFlattener.Controls"
        mc:Ignorable="d"
        Title="Fisheye Flattener" Height="800" Width="1300" MinHeight="600" MinWidth="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: preview + open/export -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#202020" BorderBrush="#404040" BorderThickness="1">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" Cursor="SizeAll"
                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                       MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                       MouseMove="PreviewImage_MouseMove"
                       MouseWheel="PreviewImage_MouseWheel"/>
            </Border>

            <Grid x:Name="PlaybackPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Grid.Column="0" Content="Play" Padding="10,5" Width="70"
                        Click="PlayPauseButton_Click"/>
                <Slider x:Name="PositionSlider" Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                        ValueChanged="PositionSlider_ValueChanged"/>
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center"
                           MinWidth="90" HorizontalAlignment="Right"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="OpenButton" Content="Open Fisheye File..." Padding="10,5" Click="OpenButton_Click"/>
                <Button x:Name="ExportButton" Content="Export Flattened..." Padding="10,5" Margin="8,0,0,0"
                        IsEnabled="False" Click="ExportButton_Click"/>
                <Button x:Name="ResetViewButton" Content="Reset View" Padding="10,5" Margin="8,0,0,0"
                        Click="ResetViewButton_Click"/>
            </StackPanel>

            <ProgressBar x:Name="ExportProgress" Grid.Row="3" Height="18" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,6,0,0"
                       Text="Open an exported Protect fisheye image or clip to begin. Drag the image to look around, scroll to zoom."/>
        </Grid>

        <!-- Right: controls -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Lens Calibration" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <controls:NumericSlider x:Name="CenterXSlider" Label="Center X"
                                                 Minimum="0" Maximum="8000" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="CenterYSlider" Label="Center Y"
                                                 Minimum="0" Maximum="8000" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="RadiusSlider" Label="Circle radius (px)"
                                                 Minimum="1" Maximum="4000" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="MaxFovSlider" Label="Lens FOV (deg)"
                                                 Minimum="60" Maximum="220" Value="180" ValueChanged="Param_ValueChanged"/>

                        <Button x:Name="AutoDetectButton" Content="Auto-detect circle" Margin="0,6,0,0"
                                Padding="6,4" HorizontalAlignment="Left" Click="AutoDetectButton_Click"/>

                        <TextBlock Text="Source correction (if the camera is mounted flipped/mirrored):"
                                   Margin="0,10,0,4" TextWrapping="Wrap" Opacity="0.8"/>
                        <CheckBox x:Name="SourceFlipHCheck" Content="Flip source horizontally" Margin="0,2"
                                  Checked="SourceFlipH_Changed" Unchecked="SourceFlipH_Changed"/>
                        <CheckBox x:Name="SourceFlipVCheck" Content="Flip source vertically" Margin="0,2"
                                  Checked="SourceFlipV_Changed" Unchecked="SourceFlipV_Changed"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="View" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Drag the preview to look around. Scroll to zoom."
                                   Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8"/>
                        <controls:NumericSlider x:Name="FovSlider" Label="Zoom (field of view, deg)"
                                                 Minimum="30" Maximum="170" Value="90" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="PerspWidthSlider" Label="Output width"
                                                 Minimum="160" Maximum="3840" Value="1280" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="PerspHeightSlider" Label="Output height"
                                                 Minimum="120" Maximum="2160" Value="720" ValueChanged="Param_ValueChanged"/>

                        <TextBlock Text="Level: if a wall or door edge looks tilted, correct it once and it stays level everywhere you pan:"
                                   Margin="0,10,0,4" TextWrapping="Wrap" Opacity="0.8"/>
                        <controls:NumericSlider x:Name="RollSlider" Label="Roll (deg)"
                                                 Minimum="-180" Maximum="180" Value="0" ValueChanged="Param_ValueChanged"/>
                        <Button x:Name="SnapLevelButton" Content="Snap Level (click 2 points)" Margin="0,6,0,0"
                                Padding="6,4" HorizontalAlignment="Left" Click="SnapLevelButton_Click"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
