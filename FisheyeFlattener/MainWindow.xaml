<Window x:Class="FisheyeFlattener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FisheyeFlattener.Controls"
        mc:Ignorable="d"
        Title="Fisheye Flattener" Height="800" Width="1300" MinHeight="600" MinWidth="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: preview + open/export -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#202020" BorderBrush="#404040" BorderThickness="1">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="OpenButton" Content="Open Fisheye File..." Padding="10,5" Click="OpenButton_Click"/>
                <Button x:Name="ExportButton" Content="Export Flattened..." Padding="10,5" Margin="8,0,0,0"
                        IsEnabled="False" Click="ExportButton_Click"/>
            </StackPanel>

            <ProgressBar x:Name="ExportProgress" Grid.Row="2" Height="18" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,6,0,0"
                       Text="Open an exported Protect fisheye image or clip to begin."/>
        </Grid>

        <!-- Right: controls -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Lens Calibration" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <ComboBox x:Name="MountCombo" Margin="0,0,0,8"
                                  SelectionChanged="MountCombo_SelectionChanged">
                            <ComboBoxItem Content="Ceiling (looking down)" IsSelected="True"/>
                            <ComboBoxItem Content="Wall (looking out)"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>

                        <controls:NumericSlider x:Name="CenterXSlider" Label="Center X"
                                                 Minimum="0" Maximum="8000" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="CenterYSlider" Label="Center Y"
                                                 Minimum="0" Maximum="8000" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="RadiusSlider" Label="Circle radius (px)"
                                                 Minimum="1" Maximum="4000" ValueChanged="Param_ValueChanged"/>
                        <controls:NumericSlider x:Name="MaxFovSlider" Label="Lens FOV (deg)"
                                                 Minimum="60" Maximum="220" Value="180" ValueChanged="Param_ValueChanged"/>

                        <Button x:Name="AutoDetectButton" Content="Auto-detect circle" Margin="0,6,0,0"
                                Padding="6,4" HorizontalAlignment="Left" Click="AutoDetectButton_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Flatten Mode" Padding="8">
                    <StackPanel>
                        <ComboBox x:Name="ModeCombo" Margin="0,0,0,8"
                                  SelectionChanged="ModeCombo_SelectionChanged">
                            <ComboBoxItem Content="Perspective (single view)" IsSelected="True"/>
                            <ComboBoxItem Content="Panorama (360 unwrap)"/>
                        </ComboBox>

                        <StackPanel x:Name="PerspectivePanel">
                            <controls:NumericSlider x:Name="YawSlider" Label="Yaw (deg)"
                                                     Minimum="-180" Maximum="180" Value="0" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="PitchSlider" Label="Pitch (deg)"
                                                     Minimum="-90" Maximum="90" Value="-60" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="FovSlider" Label="Field of view (deg)"
                                                     Minimum="30" Maximum="170" Value="90" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="PerspWidthSlider" Label="Output width"
                                                     Minimum="160" Maximum="3840" Value="1280" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="PerspHeightSlider" Label="Output height"
                                                     Minimum="120" Maximum="2160" Value="720" ValueChanged="Param_ValueChanged"/>
                        </StackPanel>

                        <StackPanel x:Name="PanoramaPanel" Visibility="Collapsed">
                            <controls:NumericSlider x:Name="AzStartSlider" Label="Azimuth start (deg)"
                                                     Minimum="-360" Maximum="360" Value="-180" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="AzEndSlider" Label="Azimuth end (deg)"
                                                     Minimum="-360" Maximum="360" Value="180" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="ThetaTopSlider" Label="Top angle from axis (deg)"
                                                     Minimum="1" Maximum="110" Value="90" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="ThetaBottomSlider" Label="Bottom angle from axis (deg)"
                                                     Minimum="0" Maximum="110" Value="10" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="ReferenceSlider" Label="Reference rotation (deg)"
                                                     Minimum="-360" Maximum="360" Value="0" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="PanoWidthSlider" Label="Output width"
                                                     Minimum="320" Maximum="6000" Value="2048" ValueChanged="Param_ValueChanged"/>
                            <controls:NumericSlider x:Name="PanoHeightSlider" Label="Output height"
                                                     Minimum="120" Maximum="3000" Value="512" ValueChanged="Param_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
