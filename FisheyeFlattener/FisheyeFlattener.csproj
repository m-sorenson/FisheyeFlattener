<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For System.Windows.Forms.NotifyIcon - WPF has no built-in system tray icon
         support, and NotifyIcon is the standard way to get one on .NET/Windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- Without this, a self-contained publish bundles every language's satellite
         resource DLLs for WPF/WinForms' own framework strings (13 languages'
         worth, unused - the app's own UI text is all English anyway and isn't
         localized), inflating the installer for no benefit. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FisheyeFlattener.Core\FisheyeFlattener.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms implicitly adds a global "using System.Windows.Forms;",
         which collides with WPF's own Application/UserControl/KeyEventArgs/
         MouseEventArgs types used unqualified throughout this project. Removing it
         means WinForms types (NotifyIcon etc.) must be referenced fully-qualified,
         which is what the tray icon code already does. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
